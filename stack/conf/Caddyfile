# TLS edge, automatic issue + renew. Uploads stream straight to atticd; everything
# else goes through the nginx disk cache. Both upstreams are localhost.
{
	admin off
	grace_period 10s
}

icedos.mirrors.knp.one {
	@api {
		path /_api/*
	}
	handle @api {
		reverse_proxy 127.0.0.1:8080 {
			header_up Host {host}
		}
	}

	handle {
		reverse_proxy unix//run/icedos-nginx.sock
	}
}
